# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your API credentials:
#   cp .env.example .env
#
# DO NOT commit .env with real secrets to version control!
# ==============================================================================

# LLM Providers (At least one required for generator, one for judge)
# Free Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Free Google Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional: OpenAI / Hugging Face token (if using Colab / HF hub)
OPENAI_API_KEY=
HF_TOKEN=

# Cache & Environment settings
ENVIRONMENT=development
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=results/.llm_cache.sqlite
